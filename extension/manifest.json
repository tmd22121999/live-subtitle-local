{
  "manifest_version": 3,
  "name": "Local Vietnamese Live Subtitles",
  "version": "0.1.0",
  "description": "Capture selected tab audio and display locally translated Vietnamese subtitles.",
  "permissions": ["tabCapture", "offscreen", "activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8766/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"},
  "web_accessible_resources": [{"resources": ["processor.js"], "matches": ["<all_urls>"]}]
}
